+  button:active:hover,
+  .btn:active:hover,
+  [role="button"]:active:hover {
+    transform: scale(0.97);
+  }
+}
+
+:focus-visible {
+  outline: 2px solid var(--jade);
+  outline-offset: 2px;
+  border-radius: 6px;
